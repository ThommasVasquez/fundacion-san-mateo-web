{
  "name": "fsm-modern",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build && rm -rf out && mkdir out && cp -r .open-next/assets/* out/ && cp .open-next/worker.js out/_worker.js && cp public/_routes.json out/_routes.json && cp -r .open-next/cloudflare out/ && cp -r .open-next/middleware out/ && cp -r .open-next/server-functions out/ && cp -r .open-next/.build out/",
    "preview": "npm run build:cloudflare && wrangler dev",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "lint": "eslint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lucide-react": "^0.474.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.81.1"
  }
}
